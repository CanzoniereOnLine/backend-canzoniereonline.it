FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates perl fontconfig xindy curl texlive-full \
    gcc libc6-dev \  
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/share/texmf/doc \
    && rm -rf /usr/share/texlive/texmf-dis  t/doc \
    && rm -rf /usr/share/texlive/texmf-dist/source \
    && find /usr/share/texlive/texmf-dist/tex/generic/babel-* \
       -mindepth 0 -maxdepth 0 \
       ! -name 'babel-italian' ! -name 'babel-english' \
       -exec rm -rf {} + 2>/dev/null || true \
    && find /usr/share/texlive/texmf-dist/fonts \
       -name "*.pfb" -o -name "*.afm" \
       | grep -v -E "libertine|palatino|lm|cm|euler" \
       | xargs rm -f 2>/dev/null || true

RUN ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/') && \
    curl -L https://go.dev/dl/go1.22.3.linux-${ARCH}.tar.gz | tar -C /usr/local -xz
    
ENV PATH="/usr/local/go/bin:${PATH}"

RUN fc-cache -fv

WORKDIR /app